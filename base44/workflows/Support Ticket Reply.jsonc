{
  "name": "Support Ticket Reply",
  "description": "Fires when a person replies on their own ticket: confirms and closes a fixed one, reopens a closed one, escalates after two unresolved replies, and otherwise answers from the help articles.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "TicketMessage",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.author == \"user\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "support_ticket_reply",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "handle_reply": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "supportAutomation",
            "args": {
              "action": "respond",
              "message_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Answer the person's reply",
            "description": "Gated, logged, one reply at most"
          }
        }
      }
    ]
  }
}