{
  "name": "BehaviourRun",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The signed-in account that owns this run. Only that account, or an admin, can read it."
    },
    "mode": {
      "type": "string",
      "enum": [
        "behaviour",
        "escalation"
      ],
      "default": "behaviour",
      "description": "behaviour = the six-behaviour transcript and its review; escalation = the thirty-six turn ladder, which records the rule's decisions and sends nothing to a model"
    },
    "seed": {
      "type": "string",
      "description": "The seed the order and the payload choice were drawn from. A different seed gives a different order and a different payload, so a run is never the same table twice."
    },
    "order": {
      "type": "string",
      "description": "The behaviour ids this run used, in the order it drew them, comma separated"
    },
    "model": {
      "type": "string",
      "description": "The one model the turns were sent to. Empty for the escalation ladder, which is never sent."
    },
    "model_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "collecting",
        "awaiting_review",
        "reviewed"
      ],
      "default": "collecting",
      "description": "collecting = turns still to be sent; awaiting_review = every turn answered and waiting on a person; reviewed = every turn judged, so the report may be read"
    },
    "turns_total": {
      "type": "number",
      "default": 0,
      "description": "How many turns this run holds"
    },
    "turns_reviewed": {
      "type": "number",
      "default": 0,
      "description": "How many turns a person has judged"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "maxLength": 300
    }
  },
  "required": [
    "user_id",
    "seed",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}