{
  "name": "FirewallRule",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "rule_name": {
      "type": "string",
      "description": "Descriptive name for the firewall rule"
    },
    "rule_type": {
      "type": "string",
      "enum": [
        "allow",
        "block",
        "rate_limit"
      ],
      "default": "block",
      "description": "Action to take when rule matches"
    },
    "priority": {
      "type": "number",
      "description": "Rule priority (lower = higher priority)",
      "default": 100
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "source_ip": {
      "type": "string",
      "description": "Source IP or CIDR range"
    },
    "source_ip_range": {
      "type": "string",
      "description": "IP range in format start-end"
    },
    "destination_port": {
      "type": "string",
      "description": "Port or port range"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp",
        "any"
      ],
      "default": "tcp"
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "both"
      ],
      "default": "inbound"
    },
    "rate_limit_requests": {
      "type": "number",
      "description": "Max requests per minute (for rate_limit rules)"
    },
    "hit_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times this rule was triggered"
    },
    "last_hit": {
      "type": "string",
      "format": "date-time",
      "description": "Last time this rule was triggered"
    },
    "description": {
      "type": "string",
      "description": "Detailed description of the rule purpose"
    },
    "tags": {
      "type": "string",
      "description": "Comma-separated tags for categorization"
    }
  },
  "required": [
    "rule_name",
    "rule_type"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}