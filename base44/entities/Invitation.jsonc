{
  "name": "Invitation",
  "type": "object",
  "properties": {
    "subscriber_id": {
      "type": "string",
      "description": "User ID of the subscription owner who sent the invite"
    },
    "subscriber_email": {
      "type": "string",
      "description": "Email of the subscription owner"
    },
    "invitee_email": {
      "type": "string",
      "description": "Email address of the person being invited"
    },
    "invitee_phone": {
      "type": "string",
      "description": "Optional phone number for SMS"
    },
    "invitation_token": {
      "type": "string",
      "description": "Unique secure token for acceptance"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "accepted",
        "expired",
        "revoked"
      ],
      "default": "pending",
      "description": "Current status of the invitation"
    },
    "device_slots": {
      "type": "number",
      "description": "Number of device slots allocated to this invitee",
      "default": 1,
      "minimum": 1,
      "maximum": 10
    },
    "slots_used": {
      "type": "number",
      "default": 0,
      "minimum": 0,
      "description": "Device slots this invitation has already enrolled. Enrollment is refused once it reaches device_slots, so one invitation can never enroll unlimited devices"
    },
    "consumed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the last allocated slot was enrolled, so this invitation is spent and cannot be enrolled from again"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation expires"
    },
    "accepted_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the invitation was accepted"
    },
    "accepted_by_user_id": {
      "type": "string",
      "description": "User ID of the person who accepted (if they registered)"
    },
    "notes": {
      "type": "string",
      "description": "Optional notes from subscriber"
    }
  },
  "required": [
    "subscriber_id",
    "subscriber_email",
    "invitee_email",
    "invitation_token",
    "expires_at"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.subscriber_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.subscriber_id": "{{user.id}}"
        },
        {
          "data.invitee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.subscriber_id": "{{user.id}}"
        },
        {
          "data.invitee_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.subscriber_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}