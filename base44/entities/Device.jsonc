{
  "name": "Device",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of the device record"
    },
    "subscriber_id": {
      "type": "string",
      "description": "ID of the subscription owner (for family devices)"
    },
    "device_name": {
      "type": "string"
    },
    "device_type": {
      "type": "string",
      "enum": [
        "android",
        "ios",
        "desktop",
        "tablet",
        "other"
      ],
      "default": "android"
    },
    "device_fingerprint": {
      "type": "string",
      "description": "Unique device identifier"
    },
    "last_seen": {
      "type": "string",
      "format": "date-time",
      "description": "Last time a check was filed against this device"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "removed"
      ],
      "default": "active"
    },
    "description": {
      "type": "string",
      "maxLength": 1000,
      "description": "Optional note from the owner about the device"
    }
  },
  "required": [
    "device_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "data.subscriber_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}