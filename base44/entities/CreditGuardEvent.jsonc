{
  "name": "CreditGuardEvent",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "description": "Which credit-spending action this record counts, e.g. helper_ask, helper_ticket, support_chat, support_email, text_analysis"
    },
    "owner_key": {
      "type": "string",
      "description": "user:<id> for a signed-in account, or guest for visitors with no account"
    },
    "bucket": {
      "type": "string",
      "description": "The day this spend belongs to, as YYYY-MM-DD"
    }
  },
  "required": [
    "kind",
    "owner_key",
    "bucket"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}