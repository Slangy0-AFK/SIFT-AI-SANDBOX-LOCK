{
  "name": "EmailThreat",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "message_id": {
      "type": "string",
      "description": "Gmail message ID"
    },
    "from_address": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "threat_type": {
      "type": "string",
      "enum": [
        "phishing",
        "scam",
        "malware",
        "spoofing"
      ]
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100 confidence score"
    },
    "analysis_reason": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "reviewed",
        "cleared",
        "blocked"
      ],
      "default": "detected"
    },
    "scanned_date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "message_id",
    "from_address",
    "threat_type"
  ],
  "rls": {
    "create": {
      "user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}