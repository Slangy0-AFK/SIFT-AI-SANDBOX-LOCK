{
  "name": "PhoneRecoveryOtp",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Account the recovery code was issued to"
    },
    "phone_last4": {
      "type": "string",
      "description": "Last 4 digits of the phone number supplied with the request"
    },
    "code_hash": {
      "type": "string",
      "description": "HMAC-SHA256 of the 6-digit code, keyed with a server-side secret (never the bare code)"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the code stops being valid"
    },
    "attempts": {
      "type": "number",
      "default": 0,
      "description": "Failed verification attempts against this code"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "used",
        "locked"
      ],
      "default": "pending",
      "description": "locked = attempt limit reached, a new code is required"
    },
    "used_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_email",
    "code_hash",
    "expires_at"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}