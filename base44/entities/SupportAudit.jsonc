{
  "name": "SupportAudit",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "ticket_number": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "description": "What was about to happen, e.g. ask_detail, fix_check, closing, escalation, search, open_ticket"
    },
    "gate": {
      "type": "string",
      "description": "Which check decided it: tool_gate, kill_switch, loop_gate, admission, safety_check, credit_ceiling, outcome"
    },
    "decision": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked",
        "skipped",
        "completed",
        "failed"
      ]
    },
    "reason": {
      "type": "string",
      "maxLength": 1000
    },
    "actor": {
      "type": "string",
      "enum": [
        "automation",
        "agent",
        "owner",
        "user"
      ],
      "default": "automation"
    },
    "detail": {
      "type": "string",
      "maxLength": 2000
    }
  },
  "required": [
    "action",
    "gate",
    "decision"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}