{
  "name": "DeviceSubmission",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of the submission"
    },
    "email": {
      "type": "string",
      "description": "Email the account was signed in with"
    },
    "tier": {
      "type": "string",
      "enum": [
        "device_check",
        "full_audit"
      ],
      "description": "Which paid tier this submission was made under"
    },
    "device_name": {
      "type": "string"
    },
    "flagged_item": {
      "type": "string",
      "description": "The flagged scan or item the buyer wants looked at (Device Check)"
    },
    "app_list": {
      "type": "string",
      "description": "Apps installed on the device (Full Audit)"
    },
    "network_destinations": {
      "type": "string",
      "description": "Network destinations the device talks to (Full Audit)"
    },
    "notes": {
      "type": "string",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "submitted",
        "in_review",
        "delivered"
      ],
      "default": "submitted"
    },
    "verdict": {
      "type": "string",
      "description": "Verdict written by the reviewer"
    },
    "report_notes": {
      "type": "string",
      "description": "Evidence and fix list / written fix plan, max 5000 chars",
      "maxLength": 5000
    },
    "delivered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "tier",
    "device_name"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}