{
  "name": "CachedThreatFeed",
  "type": "object",
  "properties": {
    "indicator": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "ip",
        "hash",
        "domain"
      ]
    },
    "source": {
      "type": "string"
    },
    "first_seen": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "indicator",
    "type",
    "source"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}