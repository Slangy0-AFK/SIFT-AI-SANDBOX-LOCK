{
  "name": "WorkflowExecution",
  "type": "object",
  "properties": {
    "policy_id": {
      "type": "string"
    },
    "policy_name": {
      "type": "string"
    },
    "trigger_data": {
      "type": "string",
      "description": "JSON of the event that triggered this execution"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "success",
        "failed",
        "skipped"
      ],
      "default": "running"
    },
    "actions_log": {
      "type": "string",
      "description": "JSON array of action results"
    },
    "error": {
      "type": "string"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "policy_id"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}