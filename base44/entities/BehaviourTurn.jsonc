{
  "name": "BehaviourTurn",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of the run this turn belongs to. Only that account, or an admin, can read it."
    },
    "run_id": {
      "type": "string",
      "description": "The transcript this turn is part of"
    },
    "behaviour": {
      "type": "string",
      "description": "Which authored behaviour this turn targets, e.g. goal_drift"
    },
    "behaviour_label": {
      "type": "string",
      "description": "That behaviour in plain words"
    },
    "kind": {
      "type": "string",
      "enum": [
        "original",
        "held_out",
        "twin",
        "ladder"
      ],
      "default": "original",
      "description": "original = the authored payload; held_out = one of the two payloads kept only on the server; twin = the same task with written authorisation; ladder = one turn of the escalation ladder"
    },
    "cycle": {
      "type": "string",
      "description": "For a ladder turn: plain, urgency or permanent_baseline"
    },
    "sequence": {
      "type": "number",
      "description": "Position of this turn in the transcript, in the order the run drew"
    },
    "turn_number": {
      "type": "number",
      "description": "Position within its own chain. A single-message payload is turn 1."
    },
    "arm": {
      "type": "string",
      "enum": [
        "dangerous",
        "safe_twin"
      ],
      "description": "dangerous = the request as pushed; safe_twin = the same task with written authorisation"
    },
    "authorisation": {
      "type": "string",
      "enum": [
        "absent",
        "present"
      ],
      "description": "Whether the turn itself carries written authorisation for the action"
    },
    "attacker_message": {
      "type": "string",
      "description": "The message sent to the model, verbatim, or for a ladder turn the message the rule decided on. The payloads not drawn for this run are never sent."
    },
    "model": {
      "type": "string",
      "description": "The model id this turn was sent to. Empty for a ladder turn, which is never sent."
    },
    "model_label": {
      "type": "string",
      "description": "That model id in plain words"
    },
    "model_response": {
      "type": "string",
      "description": "What the model replied, verbatim and unedited. No verdict is stored with it by code."
    },
    "gate": {
      "type": "string",
      "description": "For a ladder turn: the rule's decision, refused or allowed. Empty on a behaviour turn, which the rule does not decide."
    },
    "gate_reason": {
      "type": "string",
      "maxLength": 600,
      "description": "The rule's own words for that decision"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "review_pending",
        "reviewed"
      ],
      "default": "planned",
      "description": "planned = not sent yet; review_pending = answered and waiting on a person; reviewed = a person has judged it with a quote"
    },
    "judgment": {
      "type": "string",
      "enum": [
        "",
        "objected",
        "accepted",
        "unclear"
      ],
      "default": "",
      "description": "A person's judgment of the response. Empty until a person has read it."
    },
    "quote": {
      "type": "string",
      "maxLength": 600,
      "description": "The words copied from the response that the judgment rests on. Required before a judgment is stored."
    },
    "action_taken": {
      "type": "string",
      "maxLength": 400,
      "description": "What the model actually did or refused to do, in the reviewer's words"
    },
    "reviewer_id": {
      "type": "string",
      "description": "The signed-in account that judged this turn. Never the model that wrote the response."
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "answered_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "run_id",
    "behaviour",
    "sequence",
    "arm",
    "authorisation",
    "attacker_message",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}