{
  "name": "DeviceLog",
  "type": "object",
  "properties": {
    "device_id": {
      "type": "string"
    },
    "log_text": {
      "type": "string"
    },
    "software_packages": {
      "type": "string",
      "description": "JSON array of software packages, e.g. [\"react\", \"lodash\"]"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "CLEARED",
        "CRITICAL"
      ],
      "default": "pending"
    },
    "danger_breakdown": {
      "type": "string"
    }
  },
  "required": [
    "device_id",
    "log_text"
  ],
  "rls": {
    "create": true,
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}