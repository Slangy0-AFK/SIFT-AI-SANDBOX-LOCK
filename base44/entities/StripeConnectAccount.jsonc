{
  "name": "StripeConnectAccount",
  "type": "object",
  "properties": {
    "stripe_user_id": {
      "type": "string",
      "description": "The connected Stripe account id (acct_...). Identifies which account SIFT AI payments run on."
    },
    "scope": {
      "type": "string",
      "description": "Access Stripe granted when the account was connected"
    },
    "token_type": {
      "type": "string"
    },
    "livemode": {
      "type": "boolean",
      "default": false,
      "description": "Whether the account was connected against live keys, so real charges can be taken"
    },
    "access_token_encrypted": {
      "type": "string",
      "description": "The connected account's access token, encrypted with a server-side key. Never returned to any caller and never shown in any page."
    },
    "refresh_token_encrypted": {
      "type": "string",
      "description": "Refresh token when Stripe issues one, encrypted the same way"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active",
      "description": "Only one account is active at a time; a replaced connection is stood down so the account payments use is never ambiguous"
    },
    "connected_by": {
      "type": "string",
      "description": "Admin account that completed the connection"
    },
    "connected_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "stripe_user_id",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}