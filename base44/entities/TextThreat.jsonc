{
  "name": "TextThreat",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "phone_number": {
      "type": "string"
    },
    "message_content": {
      "type": "string"
    },
    "scam_type": {
      "type": "string",
      "enum": [
        "phishing",
        "lottery",
        "banking",
        "delivery",
        "romance",
        "tech_support"
      ]
    },
    "confidence_score": {
      "type": "number",
      "description": "0-100 confidence score"
    },
    "red_flags": {
      "type": "string",
      "description": "JSON array of red flags"
    },
    "recommendation": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "analyzed",
        "reviewed",
        "reported"
      ],
      "default": "analyzed"
    },
    "analyzed_date": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "phone_number",
    "scam_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}