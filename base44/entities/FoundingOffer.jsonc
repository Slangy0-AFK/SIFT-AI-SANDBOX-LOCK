{
  "name": "FoundingOffer",
  "type": "object",
  "properties": {
    "open": {
      "type": "boolean",
      "default": true,
      "description": "Whether free founding places are still being given out. It closes itself the moment the last place is taken, and the paid checkout opens at the same moment."
    },
    "limit": {
      "type": "number",
      "default": 50,
      "description": "How many sign-ups get a free place. Fifty."
    },
    "claimed": {
      "type": "number",
      "default": 0,
      "description": "Places taken. This is only the counter the plans page shows: the count of honoured place records is what actually decides everything, and this number is refreshed from it."
    },
    "started_at": {
      "type": "string",
      "format": "date-time",
      "description": "The moment the offer opened. Only accounts created after this instant can claim a place, so the offer is for sign-ups from the day it went on."
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}