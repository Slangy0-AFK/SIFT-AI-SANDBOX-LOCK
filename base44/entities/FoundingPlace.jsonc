{
  "name": "FoundingPlace",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The account this place belongs to. Only that account, or an admin, can read it."
    },
    "email": {
      "type": "string"
    },
    "place": {
      "type": "number",
      "description": "The place number, 1 to 50, in the order the places were taken"
    },
    "granted_at": {
      "type": "string",
      "format": "date-time"
    },
    "honored": {
      "type": "boolean",
      "default": true,
      "description": "True while this place stands. A place claimed past the fifty, from two sign-ups landing at the same instant, is set to false and unlocks nothing."
    },
    "source": {
      "type": "string",
      "description": "What claimed it, e.g. signup or login"
    }
  },
  "required": [
    "user_id",
    "place"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}