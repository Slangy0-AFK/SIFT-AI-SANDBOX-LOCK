{
  "name": "ScanSession",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "scan_type": {
      "type": "string",
      "enum": [
        "virustotal_ip",
        "virustotal_domain",
        "virustotal_url",
        "virustotal_hash",
        "email",
        "sms",
        "device_scan"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "scanning",
        "complete",
        "error"
      ],
      "default": "pending"
    },
    "input_value": {
      "type": "string"
    },
    "result": {
      "type": "string",
      "description": "JSON-stringified result from backend"
    },
    "error_message": {
      "type": "string"
    },
    "threat_level": {
      "type": "string"
    },
    "is_threat": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "user_id",
    "scan_type"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}