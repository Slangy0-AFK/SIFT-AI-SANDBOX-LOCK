{
  "name": "License",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "The account this key is issued to. Empty only while a guest purchase waits to be claimed by the account that signs in with the same verified email."
    },
    "email": {
      "type": "string",
      "description": "Buyer address from checkout. Used to match an unclaimed purchase to the account that later signs in with it, and to send the buyer their own copy."
    },
    "source": {
      "type": "string",
      "enum": [
        "purchase",
        "founding"
      ],
      "description": "purchase = came from a paid order; founding = the free founding place"
    },
    "entitlement": {
      "type": "string",
      "enum": [
        "pro",
        "device_check",
        "founding"
      ],
      "description": "What was bought or granted, as the catalog names it"
    },
    "plan_label": {
      "type": "string",
      "description": "Human name of what was bought, e.g. SIFT AI Pro (monthly)"
    },
    "order_number": {
      "type": "string",
      "description": "Short reference shown to the buyer and the team, e.g. SIFT-7K3M9Q. Never derived from the key."
    },
    "purchase_id": {
      "type": "string",
      "description": "The purchase record this key was issued from. The only link from a payment to a key."
    },
    "model_name": {
      "type": "string",
      "maxLength": 120,
      "description": "The ONE model or product this key is for. Named by the buyer at purchase; for a founding key it is named by the first model that activates it. One key, one model, one use."
    },
    "deployment_id": {
      "type": "string",
      "maxLength": 160,
      "description": "The deployment ID or domain the key locked to. Never a person's details: the buyer supplies it, and it is the only place the locked key may run."
    },
    "binding_locked_at": {
      "type": "string",
      "format": "date-time",
      "description": "The moment the key locked to its one model. Set once: only one active binding exists per key, ever."
    },
    "binding_conflicts": {
      "type": "number",
      "default": 0,
      "description": "Times the same key was seen with a different binding. Each one is refused; the count and the last one seen are on the team's console."
    },
    "last_conflict_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_conflict_binding": {
      "type": "string",
      "maxLength": 200,
      "description": "The binding that was refused, e.g. 'Model B / staging-2'. Never a key."
    },
    "flagged_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when a second binding was seen for this key, so the team can look and revoke it. Cleared when a replacement key is issued."
    },
    "key_hash": {
      "type": "string",
      "description": "HMAC-SHA256 of the key under a server-side secret. This is what a key is matched against; the key itself is never stored in the clear."
    },
    "key_sha256": {
      "type": "string",
      "description": "Plain SHA-256 of the key in its canonical shape. The buyer's own product works this out for itself and sends it to the check in place of the key, so a key never travels. It cannot be turned back into a key. Filled in for keys issued earlier the first time one is checked."
    },
    "key_encrypted": {
      "type": "string",
      "description": "The key, encrypted with a server-side secret. Read back only for the buyer's own account and never listed."
    },
    "key_hint": {
      "type": "string",
      "description": "Masked form safe to show in lists, e.g. SIFT-LIC-4A2F-...."
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked",
        "expired"
      ],
      "default": "active"
    },
    "activations": {
      "type": "number",
      "default": 0,
      "description": "1 once the key has locked to its one model."
    },
    "activated_at": {
      "type": "string",
      "format": "date-time"
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time",
      "description": "The day the key stops working, for a plan bought for a set term. Empty for a key that runs while the plan runs."
    },
    "regenerated_at": {
      "type": "string",
      "format": "date-time",
      "description": "Set when a replacement key was issued. The replaced key stops working at this moment."
    },
    "revoked_at": {
      "type": "string",
      "format": "date-time"
    },
    "revoked_reason": {
      "type": "string",
      "maxLength": 200
    },
    "amount_cents": {
      "type": "number",
      "description": "What the buyer paid, for the receipt. 0 for a founding place."
    },
    "currency": {
      "type": "string",
      "default": "usd"
    },
    "paid_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "source",
    "entitlement",
    "order_number",
    "key_hash",
    "key_encrypted",
    "key_hint",
    "status"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}