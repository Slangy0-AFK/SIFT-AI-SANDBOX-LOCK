{
  "name": "TicketMessage",
  "type": "object",
  "properties": {
    "ticket_id": {
      "type": "string"
    },
    "ticket_number": {
      "type": "string"
    },
    "user_id": {
      "type": "string",
      "description": "Owner of the ticket this message belongs to; empty for a ticket sent with no account. Messages written by the automation carry the ticket owner's id so only that person can read them."
    },
    "author": {
      "type": "string",
      "enum": [
        "user",
        "support"
      ],
      "default": "user"
    },
    "automated": {
      "type": "boolean",
      "default": false,
      "description": "True when the app wrote this message on its own"
    },
    "kind": {
      "type": "string",
      "enum": [
        "user_message",
        "first_reply",
        "help_reply",
        "ask_detail",
        "status_update",
        "fix_check",
        "escalation",
        "closing",
        "reopen",
        "owner_reply"
      ],
      "default": "user_message"
    },
    "body": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "ticket_id",
    "author",
    "body"
  ],
  "rls": {
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}