{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "waiting_on_user",
        "waiting_on_team",
        "resolved",
        "closed"
      ],
      "default": "open",
      "description": "open = with automation, waiting_on_user = a detail was asked for, waiting_on_team = escalated, resolved = the person confirmed the fix, closed = closed after confirmation or 7 days of silence"
    },
    "agent_response": {
      "type": "string"
    },
    "ticket_number": {
      "type": "string",
      "description": "Short reference shown to the person, e.g. SIFT-4F3A9B"
    },
    "user_id": {
      "type": "string",
      "description": "Signed-in owner; empty for a ticket sent from the public form with no account"
    },
    "priority": {
      "type": "string",
      "enum": [
        "payment_unlock",
        "safety_flagged",
        "scan_problem",
        "account_login",
        "other"
      ],
      "default": "other",
      "description": "Triage order: payment or unlock, then a flagged item, then scanning, then account or login, then everything else"
    },
    "exchanges": {
      "type": "number",
      "default": 0,
      "description": "Replies the person has sent that did not resolve the ticket"
    },
    "escalated": {
      "type": "boolean",
      "default": false
    },
    "first_reply_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_activity_at": {
      "type": "string",
      "format": "date-time"
    },
    "closed_reason": {
      "type": "string",
      "description": "confirmed = the person said it was fixed; no_reply_7d = closed after seven days of silence"
    },
    "closed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "title",
    "description"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}