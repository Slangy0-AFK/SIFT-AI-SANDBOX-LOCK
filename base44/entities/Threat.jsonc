{
  "name": "Threat",
  "type": "object",
  "properties": {
    "source_ip": {
      "type": "string",
      "description": "IP address of the threat actor"
    },
    "threat_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "medium"
    },
    "status": {
      "type": "string",
      "enum": [
        "detected",
        "challenged",
        "cycle_1",
        "cycle_2",
        "cycle_3",
        "locked",
        "destroyed",
        "cleared"
      ],
      "default": "detected"
    },
    "paradox_response": {
      "type": "string",
      "description": "Response to the paradox lock question"
    },
    "paradox_passed": {
      "type": "boolean",
      "default": false
    },
    "qrng_cycle": {
      "type": "number",
      "default": 0
    },
    "base_chain_signature": {
      "type": "string",
      "description": "The computed base chain hash"
    },
    "environment": {
      "type": "string",
      "enum": [
        "production",
        "mirror",
        "honeypot",
        "tarpit"
      ],
      "default": "production"
    },
    "agent_type": {
      "type": "string",
      "enum": [
        "human",
        "bot",
        "autonomous_agent",
        "unknown"
      ],
      "default": "unknown"
    },
    "encoding_method": {
      "type": "string",
      "enum": [
        "none",
        "base64",
        "base60",
        "base32",
        "hex",
        "unicode",
        "mixed"
      ],
      "default": "none",
      "description": "Encoding method detected in threat payload"
    },
    "obfuscation_detected": {
      "type": "boolean",
      "default": false,
      "description": "Whether obfuscation techniques were detected"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "source_ip"
  ],
  "rls": {
    "create": {
      "created_by": "{{user.email}}"
    },
    "read": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}