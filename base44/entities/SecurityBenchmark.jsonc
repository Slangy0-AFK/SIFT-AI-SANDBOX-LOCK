{
  "name": "SecurityBenchmark",
  "type": "object",
  "properties": {
    "assessment_name": {
      "type": "string",
      "description": "Name of the security assessment"
    },
    "framework": {
      "type": "string",
      "enum": [
        "nist_csf",
        "cis_controls",
        "iso27001",
        "custom"
      ],
      "default": "nist_csf"
    },
    "overall_score": {
      "type": "number",
      "description": "Overall security score (0-100)"
    },
    "category": {
      "type": "string",
      "enum": [
        "identify",
        "protect",
        "detect",
        "respond",
        "recover"
      ],
      "description": "NIST CSF category"
    },
    "subcategory": {
      "type": "string",
      "description": "Specific subcategory (e.g., ID.AM-1)"
    },
    "control_description": {
      "type": "string"
    },
    "implementation_status": {
      "type": "string",
      "enum": [
        "not_implemented",
        "partial",
        "implemented",
        "optimized"
      ],
      "default": "not_implemented"
    },
    "maturity_level": {
      "type": "number",
      "description": "1-5 maturity level",
      "minimum": 1,
      "maximum": 5
    },
    "findings": {
      "type": "string",
      "description": "Assessment findings and notes"
    },
    "remediation_plan": {
      "type": "string"
    },
    "assessed_by": {
      "type": "string"
    },
    "next_review_date": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "assessment_name",
    "framework",
    "category"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}