{
  "name": "ApiKey",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner of the key"
    },
    "name": {
      "type": "string",
      "description": "Friendly label, e.g. 'My Store Checkout'"
    },
    "site_key": {
      "type": "string",
      "description": "Public key embedded in the widget"
    },
    "secret_hash": {
      "type": "string",
      "description": "SHA-256 hash of the secret key (secret itself is never stored)"
    },
    "secret_prefix": {
      "type": "string",
      "description": "First characters of the secret for display"
    },
    "allowed_domains": {
      "type": "string",
      "description": "Comma-separated hostnames allowed to use the widget; empty = any"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "revoked"
      ],
      "default": "active"
    },
    "verify_count": {
      "type": "number",
      "default": 0
    },
    "scan_count": {
      "type": "number",
      "default": 0
    },
    "guard_count": {
      "type": "number",
      "default": 0
    },
    "last_used": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "name",
    "site_key",
    "secret_hash"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}