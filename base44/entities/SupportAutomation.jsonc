{
  "name": "SupportAutomation",
  "type": "object",
  "properties": {
    "paused": {
      "type": "boolean",
      "default": false,
      "description": "The kill switch. While true, no automated support action runs at all."
    },
    "reason": {
      "type": "string",
      "maxLength": 300,
      "description": "Why it is paused, shown in the audit log"
    },
    "paused_at": {
      "type": "string",
      "format": "date-time"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}