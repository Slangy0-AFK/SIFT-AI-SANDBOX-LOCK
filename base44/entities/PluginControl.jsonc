{
  "name": "PluginControl",
  "type": "object",
  "properties": {
    "kill_switch": {
      "type": "boolean",
      "default": false,
      "description": "The SIFT AI team's stop switch for the plug-in. While it is on, every check answers Stopped and no plug-in runs anywhere. Only the team can set it."
    },
    "reason": {
      "type": "string",
      "maxLength": 300,
      "description": "Why it was switched on, kept with the switch so the answer always carries a reason"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time",
      "description": "When the switch was last changed"
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}