{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "pro",
        "enterprise"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "cancelled",
        "expired",
        "trial"
      ],
      "default": "active"
    },
    "billing_cycle": {
      "type": "string",
      "enum": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "renewal_date": {
      "type": "string",
      "format": "date"
    },
    "play_store_purchase_token": {
      "type": "string"
    },
    "play_store_order_id": {
      "type": "string"
    }
  },
  "required": [
    "user_id",
    "plan"
  ]
}