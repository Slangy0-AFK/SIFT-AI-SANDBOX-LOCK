{
  "name": "PromptGuardEvent",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Owner (app user or API key owner)"
    },
    "api_key_id": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "playground",
        "api"
      ],
      "default": "playground"
    },
    "direction": {
      "type": "string",
      "enum": [
        "input",
        "output"
      ],
      "default": "input"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "allow",
        "flag",
        "block"
      ]
    },
    "risk_score": {
      "type": "number"
    },
    "categories": {
      "type": "string",
      "description": "Comma-separated categories"
    },
    "snippet": {
      "type": "string",
      "description": "First 200 chars of the analyzed text"
    },
    "mode": {
      "type": "string",
      "enum": [
        "fast",
        "deep"
      ],
      "default": "fast"
    }
  },
  "required": [
    "verdict",
    "risk_score"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}