{
  "name": "FirewallLog",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "rule_id": {
      "type": "string",
      "description": "ID of the firewall rule that was triggered"
    },
    "rule_name": {
      "type": "string",
      "description": "Name of the firewall rule"
    },
    "action_taken": {
      "type": "string",
      "enum": [
        "allowed",
        "blocked",
        "rate_limited"
      ],
      "description": "Action taken by the firewall"
    },
    "source_ip": {
      "type": "string",
      "description": "Source IP address of the traffic"
    },
    "destination_ip": {
      "type": "string",
      "description": "Destination IP address"
    },
    "destination_port": {
      "type": "string",
      "description": "Destination port"
    },
    "protocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp",
        "icmp",
        "any"
      ]
    },
    "direction": {
      "type": "string",
      "enum": [
        "inbound",
        "outbound",
        "both"
      ]
    },
    "bytes_transferred": {
      "type": "number",
      "default": 0
    },
    "packets_count": {
      "type": "number",
      "default": 0
    },
    "threat_level": {
      "type": "string",
      "enum": [
        "info",
        "low",
        "medium",
        "high",
        "critical"
      ],
      "default": "info"
    },
    "geo_location": {
      "type": "string",
      "description": "Geographic location of source IP"
    },
    "user_agent": {
      "type": "string",
      "description": "User agent string if available"
    },
    "payload_snippet": {
      "type": "string",
      "description": "First 500 chars of payload for analysis"
    },
    "blocked_reason": {
      "type": "string",
      "description": "Reason for blocking if applicable"
    }
  },
  "required": [
    "rule_id",
    "action_taken",
    "source_ip"
  ],
  "rls": {
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}