{
  "name": "siftai-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "migrate": "node dist/database/migrate.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:migrations": "npm run build && node --test test/*.integration.mjs"
  },
  "dependencies": {
    "express": "^5.3.0",
    "nodemailer": "^10.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.0",
    "typescript": "^5.8.2"
  }
}
